{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fates-beta",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "routes": [{ "pattern": "beta.rurupop.com", "custom_domain": true }],
  "vars": {
    "BETA_OPEN": "true",
    "TEST_ROUND": "staff-check"
  },
  // シークレット（wrangler secret put で設定。ここには書かない）：BETA_ID, BETA_PASSWORD, COOKIE_SECRET
  "d1_databases": [{ "binding": "DB", "database_name": "fates_beta", "database_id": "f0b4d0df-0833-4373-bbb9-8ff22be5590f" }],
  "ratelimits": [{ "name": "LOGIN_RL", "namespace_id": "7701", "simple": { "limit": 10, "period": 60 } }]
}
